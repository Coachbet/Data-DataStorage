# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Virtual environments and uv/Python tooling
.venv/
venv/
env/

# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key

# Streamlit local state and secrets
.streamlit/secrets.toml

# Notebooks
.ipynb_checkpoints/

# Editors and operating systems
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Logs and temporary files
*.log
tmp/
temp/
.cache/

# Build and packaging outputs
build/
dist/
*.egg-info/

# Generated data: keep directories and small documented samples only
data/raw/**
data/interim/**
data/processed/**
data/external/**
!data/raw/**/
!data/raw/**/manifest.json
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep
!data/samples/**

# LaTeX build files of the report (only the .tex sources and the PDF are versioned)
report/*.aux
report/*.out
report/*.toc
report/*.fls
report/*.fdb_latexmk
report/*.synctex.gz
report/*.bbl
report/*.blg

# Local databases and downloaded archives
*.db
*.sqlite
*.sqlite3
*.duckdb
*.parquet
*.feather
*.arrow
*.zip
*.7z
*.tar
*.tar.gz

# Keep the reproducible dependency lockfile tracked
!uv.lock

data/archive/
*.part

# Small, verified aggregate snapshots for offline teaching/review.
# Only these explicit files may enter Git.
data/bundled/**
!data/bundled/**/
!data/bundled/*/areas.parquet
!data/bundled/*/outcomes.parquet
!data/bundled/*/options.parquet
!data/bundled/*/quality_report.json
!data/bundled/predictions.parquet
!data/bundled/evaluation_report.json
!data/bundled/crosscheck_*.json

# Documents generated by `make analysis` from docs/templates/ (not versioned).
docs/report/*
!docs/report/.gitkeep
