{
  "name": "Vote transfer (Python 3.12)",
  // Same Python as pyproject.toml (>=3.12,<3.13); uv installs the locked versions.
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "site/app.py"]
    },
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance", "charliermarsh.ruff"]
    }
  },
  "updateContentCommand": "pip install --user uv && ~/.local/bin/uv sync --locked --dev",
  "postAttachCommand": {
    "server": "~/.local/bin/uv run streamlit run site/app.py --server.enableCORS false --server.enableXsrfProtection false"
  },
  "portsAttributes": {
    "8501": { "label": "Website", "onAutoForward": "openPreview" }
  },
  "forwardPorts": [8501]
}
